@{
    ViewData["Title"] = "Teacher Portal";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card mt-5">
                <div class="card-body text-center py-5">
                    <i class="fas fa-chalkboard-teacher fa-5x text-primary mb-4"></i>
                    <h1 class="display-5 mb-3">Welcome to Teacher Portal</h1>
                    <p class="lead mb-4">Manage your classes, timetable, and profile all in one place.</p>
                    <div class="d-grid gap-2 d-md-block">
                        <a asp-action="Dashboard" class="btn btn-primary btn-lg px-5">
                            <i class="fas fa-tachometer-alt me-2"></i> Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>