@model Teacher

@{
    ViewData["Title"] = "My Classes";
    Layout = "_Layout";
}

<div class="container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Classes & Subjects</h2>
        <div>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (Model.ClassSubjects != null && Model.ClassSubjects.Any())
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Class Assignments</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th>Subject</th>
                                <th>Subject Code</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cs in Model.ClassSubjects.OrderBy(cs => cs.Class?.ClassName))
                            {
                                <tr>
                                    <td>@cs.Class?.ClassName</td>
                                    <td>@cs.Subject?.SubjectName</td>
                                    <td><span class="badge bg-info">@cs.Subject?.SubjectCode</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Summary -->
        <div class="card mt-3">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4">
                        <h4>@Model.ClassSubjects.Count()</h4>
                        <p class="text-muted">Total Classes</p>
                    </div>
                    <div class="col-md-4">
                        <h4>@Model.ClassSubjects.Select(cs => cs.SubjectId).Distinct().Count()</h4>
                        <p class="text-muted">Total Subjects</p>
                    </div>
                    <div class="col-md-4">
                        <h4>@Model.ClassSubjects.Select(cs => cs.ClassId).Distinct().Count()</h4>
                        <p class="text-muted">Different Classes</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="fas fa-chalkboard-teacher fa-4x text-muted mb-3"></i>
                <h4>No classes assigned</h4>
                <p class="text-muted">You haven't been assigned to any classes yet.</p>
                <p class="text-muted">Please contact your department head for class assignments.</p>
            </div>
        </div>
    }
</div>