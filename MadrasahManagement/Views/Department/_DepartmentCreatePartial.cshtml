@model MadrasahManagement.Models.Department
@{
    ViewData["Title"] = "Create Department";
}

<form id="deptCreateForm" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="DepartmentName" class="form-label"></label>
        <input asp-for="DepartmentName" class="form-control" placeholder="Enter Department Name" required />
        <span asp-validation-for="DepartmentName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" placeholder="Enter Description"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create
        </button>

        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle"></i> Close
        </button>
    </div>
</form>

<script>
    $(document).ready(function() {
        $("#deptCreateForm").submit(function (e) {
            e.preventDefault();

            var form = $(this);
            var submitBtn = form.find('.btn-primary');
            var originalText = submitBtn.html();

            // Show loading
            submitBtn.html('<span class="spinner-border spinner-border-sm"></span> Creating...').prop('disabled', true);

            $.ajax({
                url: "/Department/Save", // CORRECT URL
                type: "POST",
                data: form.serialize(),
                    // In _DepartmentCreatePartial.cshtml, update the success callback:
       success: function (res) {
        submitBtn.html(originalText).prop('disabled', false);

        if (res.success) {
            alert('✅ Department created successfully!');
            $('#departmentModal').modal('hide');

            // Call the global refresh function
            setTimeout(function() {
                if (typeof RefreshDepartmentList === 'function') {
                    RefreshDepartmentList();
                } else {
                    console.error("RefreshDepartmentList not found");
                    location.reload();
                }
            }, 300);
        } else {
            alert("Please fix the errors and try again.");
        }
    },
                error: function(xhr, status, error) {
                    submitBtn.html(originalText).prop('disabled', false);
                    alert("Error creating department: " + error);
                }
            });
        });
    });
</script>