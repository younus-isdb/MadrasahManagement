@model MadrasahManagement.Models.ExamRoutine

@{
    ViewData["Title"] = "Edit Exam Routine";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ExamRoutineId" />

    <div class="form-group mb-3">
        <label asp-for="EducationYear"></label>
        <input asp-for="EducationYear" class="form-control" />
        <span asp-validation-for="EducationYear" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ClassId">Class</label>
        <select asp-for="ClassId" class="form-select" asp-items="@(ViewData["ClassId"] as SelectList)">
            <option value="">-- Select Class --</option>
        </select>
        <span asp-validation-for="ClassId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ExamId">Exam</label>
        <select asp-for="ExamId" class="form-select" asp-items="@(ViewData["ExamId"] as SelectList)">
            <option value="">-- Select Exam --</option>
        </select>
        <span asp-validation-for="ExamId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="SubjectId">Subject</label>
        <select asp-for="SubjectId" class="form-select" asp-items="@(ViewData["SubjectId"] as SelectList)">
            <option value="">-- Select Subject --</option>
        </select>
        <span asp-validation-for="SubjectId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="RoomNumber"></label>
        <input asp-for="RoomNumber" class="form-control" />
        <span asp-validation-for="RoomNumber" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ExamDate"></label>
        <input asp-for="ExamDate" type="date" class="form-control" />
        <span asp-validation-for="ExamDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ExamStartTime"></label>
        <input asp-for="ExamStartTime" type="time" class="form-control" />
        <span asp-validation-for="ExamStartTime" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ExamEndTime"></label>
        <input asp-for="ExamEndTime" type="time" class="form-control" />
        <span asp-validation-for="ExamEndTime" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Changes</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
