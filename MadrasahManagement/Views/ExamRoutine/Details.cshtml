@* Views/ExamRoutine/Details.cshtml - PRINT VERSION *@
@model MadrasahManagement.ViewModels.ExamRoutineGroupViewModel
@{
    ViewData["Title"] = "Exam Routine Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Exam Routine - @Model.ClassName - @Model.ExamName</title>
    <style>
        /* Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            background-color: #fff;
            font-size: 12pt;
        }
        
        .container {
            max-width: 210mm;
            margin: 0 auto;
            padding: 15px;
        }
        
        /* Header Styles */
        .header {
            text-align: center;
            margin-bottom: 25px;
            border-bottom: 3px double #333;
            padding-bottom: 15px;
        }
        
        .institution-name {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 5px;
        }
        
        .institution-address {
            font-size: 13px;
            color: #666;
            margin-bottom: 8px;
        }
        
        .routine-title {
            font-size: 20px;
            font-weight: bold;
            color: #2980b9;
            margin: 10px 0;
            text-transform: uppercase;
        }
        
        /* Info Section */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
            background: #f8f9fa;
            padding: 12px;
            border: 1px solid #dee2e6;
        }
        
        .info-item {
            text-align: center;
        }
        
        .info-label {
            font-size: 11px;
            color: #666;
            text-transform: uppercase;
            margin-bottom: 3px;
        }
        
        .info-value {
            font-size: 14px;
            font-weight: 600;
            color: #2c3e50;
        }
        
        /* Schedule Table */
        .schedule-section {
            margin-bottom: 25px;
        }
        
        .section-title {
            font-size: 16px;
            font-weight: 600;
            color: #2c3e50;
            background: #f8f9fa;
            padding: 8px 12px;
            border-left: 4px solid #2980b9;
            margin-bottom: 12px;
        }
        
        .schedule-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        
        .schedule-table th {
            background-color: #2c3e50;
            color: white;
            padding: 10px 6px;
            text-align: left;
            font-weight: 600;
            font-size: 13px;
            border: 1px solid #444;
        }
        
        .schedule-table td {
            padding: 8px 6px;
            border: 1px solid #ddd;
            font-size: 13px;
        }
        
        .schedule-table tr:nth-child(even) {
            background-color: #f8f9fa;
        }
        
        .serial-no {
            width: 35px;
            text-align: center;
            font-weight: bold;
        }
        
        .subject-code {
            width: 70px;
            font-weight: 600;
            color: #2980b9;
        }
        
        .subject-name {
            width: 160px;
        }
        
        .exam-date {
            width: 90px;
            text-align: center;
        }
        
        .exam-day {
            width: 70px;
            text-align: center;
        }
        
        .exam-time {
            width: 110px;
            text-align: center;
        }
        
        .room-no {
            width: 60px;
            text-align: center;
            font-weight: 600;
            color: #27ae60;
        }
        
        /* Footer */
        .footer {
            margin-top: 30px;
            padding-top: 15px;
            border-top: 1px solid #ddd;
            text-align: center;
            font-size: 11px;
            color: #666;
        }
        
        .signature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
            margin-top: 30px;
            margin-bottom: 15px;
        }
        
        .signature-line {
            border-top: 1px solid #333;
            width: 120px;
            margin: 8px auto 3px;
        }
        
        /* Print-specific styles */
        @@media print {
            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                font-size: 11pt;
            }
            
            .container {
                max-width: 100%;
                padding: 10mm;
            }
            
            .no-print {
                display: none !important;
            }
            
            .page-break {
                page-break-before: always;
            }
            
            .schedule-table {
                page-break-inside: avoid;
            }
            
            .footer {
                position: fixed;
                bottom: 0;
                width: 100%;
                background: white;
            }
            
            /* Optimize for printing */
            .info-grid, .schedule-table th {
                background-color: #f0f0f0 !important;
            }
            
            .schedule-table td, .schedule-table th {
                border: 1px solid #000 !important;
            }
        }
        
        /* Badges */
        .badge {
            display: inline-block;
            padding: 2px 6px;
            font-size: 11px;
            font-weight: 600;
            border-radius: 2px;
            margin-right: 3px;
        }
        
        .badge-primary {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        
        .badge-success {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }
        
        .badge-info {
            background-color: #fff3cd;
            color: #856404;
            border: 1px solid #ffeaa7;
        }
        
        .badge-warning {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        
        /* Utility Classes */
        .text-center {
            text-align: center;
        }
        
        .mt-2 {
            margin-top: 0.5rem;
        }
        
        .mt-3 {
            margin-top: 1rem;
        }
        
        .mb-2 {
            margin-bottom: 0.5rem;
        }
        
        .mb-3 {
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="institution-name">MADRASAH MANAGEMENT SYSTEM</div>
            <div class="institution-address">Exam Routine - Academic Year @Model.EducationYear</div>
            <div class="routine-title">EXAMINATION ROUTINE</div>
        </div>
        
        <!-- Exam Information -->
        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Department</div>
                <div class="info-value">@Model.DepartmentName</div>
            </div>
            <div class="info-item">
                <div class="info-label">Class</div>
                <div class="info-value">@Model.ClassName</div>
            </div>
            <div class="info-item">
                <div class="info-label">Examination</div>
                <div class="info-value">@Model.ExamName</div>
            </div>
            <div class="info-item">
                <div class="info-label">Room No</div>
                <div class="info-value">@Model.RoomNumber</div>
            </div>
        </div>
        
        <!-- Schedule Table -->
        <div class="schedule-section">
            <div class="section-title">
                Exam Schedule - Total Subjects: @Model.Subjects.Count
            </div>
            
            @if (Model.Subjects.Any())
            {
                <table class="schedule-table">
                    <thead>
                        <tr>
                            <th class="serial-no">#</th>
                            <th class="subject-code">Code</th>
                            <th class="subject-name">Subject Name</th>
                            <th class="exam-date">Date</th>
                            <th class="exam-day">Day</th>
                            <th class="exam-time">Time</th>
                            <th class="room-no">Room</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int serial = 1;
                            var sortedSubjects = Model.Subjects
                                .OrderBy(s => s.ExamDate)
                                .ThenBy(s => s.ExamStartTime)
                                .ToList();
                        }
                        @foreach (var subject in sortedSubjects)
                        {
                            <tr>
                                <td class="serial-no">@serial</td>
                                <td class="subject-code">
                                    <span class="badge badge-primary">@subject.SubjectCode</span>
                                </td>
                                <td class="subject-name">@subject.SubjectName</td>
                                <td class="exam-date">
                                    @subject.ExamDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="exam-day">
                                    <span class="badge badge-info">@subject.ExamDay</span>
                                </td>
                                <td class="exam-time">
                                    @subject.ExamStartTime - @subject.ExamEndTime
                                </td>
                                <td class="room-no">@Model.RoomNumber</td>
                            </tr>
                            serial++;
                        }
                    </tbody>
                </table>
                
                @* Even simpler approach *@

                <!-- Exam Period Summary -->
                @if (Model.Subjects.Any())
                {
                    var subjectsOrdered = Model.Subjects.OrderBy(s => s.ExamDate).ToList();
                    var firstExam = subjectsOrdered.First().ExamDate;
                    var lastExam = subjectsOrdered.Last().ExamDate;
                    var totalDays = (lastExam - firstExam).Days + 1;

                    <div class="info-grid mt-3">
                        <div class="info-item">
                            <div class="info-label">Exam Period</div>
                            <div class="info-value">
                                @firstExam.ToString("dd/MM") - @lastExam.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Total Days</div>
                            <div class="info-value">@totalDays</div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Subjects/Day</div>
                            <div class="info-value">
                                @Math.Round((double)Model.Subjects.Count / totalDays, 1)
                            </div>
                        </div>
                        <div class="info-item">
                            <div class="info-label">Generated</div>
                            <div class="info-value">
                                @DateTime.Now.ToString("dd/MM/yy")
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div style="text-align: center; padding: 30px; background: #f8f9fa; border: 1px solid #ddd;">
                    No subjects found in this exam routine
                </div>
            }
        </div>
        
        <!-- Footer with Signatures -->
        <div class="footer">
            <div class="signature-grid">
                @* <div>
                    <div class="text-center">Prepared By</div>
                    <div class="signature-line"></div>
                    <div class="text-center mt-2" style="font-size: 10px;">Academic Office</div>
                </div>
                <div>
                    <div class="text-center">Checked By</div>
                    <div class="signature-line"></div>
                    <div class="text-center mt-2" style="font-size: 10px;">Department Head</div>
                </div> *@
                <div>
                    <div class="text-center">Approved By</div>
                    <div class="signature-line"></div>
                    <div class="text-center mt-2" style="font-size: 10px;">Principal</div>
                </div>
            </div>
                @*   <div class="mt-3">
                Generated on: @DateTime.Now.ToString("dd MMMM yyyy, hh:mm tt")
            </div>
            <div style="margin-top: 5px; font-size: 10px; color: #999;">
                This is a computer generated document - No signature required
            </div> *@
        </div>
    </div>
    
    <!-- Print Button (Visible only on screen) -->
    <div class="no-print" style="position: fixed; bottom: 20px; right: 20px; z-index: 1000;">
        <button onclick="window.print()" 
                style="background: #2980b9; color: white; border: none; padding: 10px 20px; 
                       border-radius: 5px; cursor: pointer; font-weight: bold; font-size: 14px;">
            🖨️ Print Routine
        </button>
        <button onclick="window.history.back()" 
                style="background: #7f8c8d; color: white; border: none; padding: 10px 20px; 
                       border-radius: 5px; cursor: pointer; font-weight: bold; margin-left: 10px; font-size: 14px;">
            ↩️ Go Back
        </button>
    </div>
    
    <script>
        // Auto-print if parameter is set
        @if (Context.Request.Query["print"] == "true")
        {
            <text>
            window.onload = function() {
                setTimeout(function() {
                    window.print();
                }, 500);
            };
            </text>
        }
        
        // Add print event listener
        window.addEventListener('afterprint', function() {
            // Optionally redirect back after printing
            @if (Context.Request.Query["autoclose"] == "true")
            {
                <text>
                setTimeout(function() {
                    window.history.back();
                }, 500);
                </text>
            }
        });
    </script>
</body>
</html>