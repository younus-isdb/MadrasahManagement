@model MadrasahManagement.ViewModels.ExamRoutineGroupViewModel

@{
    ViewData["Title"] = "Delete Exam Routine";
}

<div class="container mt-4">
    <div class="card border-danger">
        <div class="card-header bg-warning text-white">
            <h4 class="mb-0">
                <i class="fas fa-trash-alt"></i> @ViewData["Title"]
            </h4>
        </div>
        <div class="card-body">
            <div class="alert alert-danger">
                <h5><i class="fas fa-exclamation-triangle"></i> Are you sure you want to delete this exam routine?</h5>
                <p class="mb-0">This action cannot be undone.</p>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Education Year</dt>
                        <dd class="col-sm-8">@Model.EducationYear</dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">@Model.DepartmentName</dd>

                        <dt class="col-sm-4">Class</dt>
                        <dd class="col-sm-8">@Model.ClassName</dd>

                        <dt class="col-sm-4">Exam</dt>
                        <dd class="col-sm-8">@Model.ExamName</dd>

                        <dt class="col-sm-4">Room Number</dt>
                        <dd class="col-sm-8">@Model.RoomNumber</dd>
                    </dl>
                </div>
            </div>

            <h6>Subjects to be deleted:</h6>
            <div class="table-responsive mb-4">
                <table class="table table-sm table-bordered">
                    <thead class="bg-light">
                        <tr>
                            <th>Subject</th>
                            <th>Code</th>
                            <th>Date</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model.Subjects)
                        {
                            <tr>
                                <td>@subject.SubjectName</td>
                                <td>@subject.SubjectCode</td>
                                <td>@subject.ExamDate.ToString("yyyy-MM-dd")</td>
                                <td>@subject.ExamStartTime - @subject.ExamEndTime</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="educationYear" value="@Model.EducationYear" />
                <input type="hidden" name="classId" value="@Model.ClassId" />
                <input type="hidden" name="examId" value="@Model.ExamId" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>