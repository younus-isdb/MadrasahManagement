@model ExamFee

<h2>Create Exam Fee</h2>

<form asp-action="Create" method="post" id="examFeeForm">
    <div class="form-group">
        <label>Education Year</label>
        <input asp-for="EducationYear" class="form-control" />
    </div>

    <div class="form-group">
        <label>Department</label>
        <select asp-for="DepartmentId" asp-items="ViewBag.DepartmentId"
                class="form-control" id="departmentSelect">
            <option value="">-- Select Department --</option>
        </select>
    </div>

    <div class="form-group">
        <label>Class</label>
        <select asp-for="ClassId" asp-items="ViewBag.ClassId"
                class="form-control" id="classSelect">
            <option value="">-- Select Class --</option>
        </select>
    </div>

    <div class="form-group">
        <label>Exam</label>
        <select asp-for="ExamId" asp-items="ViewBag.ExamId" class="form-control">
            <option value="">-- Select Exam --</option>
        </select>
    </div>

    <div class="form-group">
        <label>Exam Fee</label>
        <input asp-for="ExamAmount" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        // Minimal JavaScript for department-class cascade
        document.getElementById('departmentSelect').addEventListener('change', function() {
            var departmentId = this.value;
            var classSelect = document.getElementById('classSelect');

            if (departmentId) {
                // Clear existing options
                classSelect.innerHTML = '<option value="">-- Select Class --</option>';

                // Fetch classes for selected department
                fetch('/ExaminationFee/GetClassesByDepartment?departmentId=' + departmentId)
                    .then(response => response.json())
                    .then(data => {
                        data.forEach(function(classItem) {
                            var option = document.createElement('option');
                            option.value = classItem.classId;
                            option.text = classItem.className;
                            classSelect.appendChild(option);
                        });
                    })
                    .catch(error => console.error('Error:', error));
            } else {
                // Clear classes if no department selected
                classSelect.innerHTML = '<option value="">-- Select Class --</option>';
            }
        });
    </script>
}