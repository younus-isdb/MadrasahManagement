@model MadrasahManagement.Models.Teacher

@{
    ViewData["Title"] = "Teacher Details";
}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <h1 class="h2 text-dark mb-2">Teacher Information</h1>
                <p class=" text-muted

">Detailed view of teacher profile</p>

                </div>
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    <div class="row">
                        <!-- Teacher Image -->
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="col-md-4 text-center mb-4">
                                <div class="bg-light rounded p-3">
                                    <img src="@Model.ImageFile" alt="@Model.Name" class="img-fluid rounded shadow" style="max-height: 300px;">
                                </div>
                            </div>
                        }
                       
                        <!-- Teacher Information -->
                        <div class="@(string.IsNullOrEmpty(Model.ImageUrl) ? "col-12" : "col-md-8")">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class=" form-label

    fw-semibold text-muted small mb-1">Name</label>

                                        <div class="fs-5 text-dark">@Model.Name</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class=" form-label

    fw-semibold text-muted small mb-1">Email</label>

                                        <div class="fs-6 text-dark">@Model.Email</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class=" form-label

    fw-semibold text-muted small mb-1">Contact</label>

                                        <div class="fs-6 text-dark">@Model.Contact</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class=" form-label fw-semibold text-muted small mb-1">salary</label>

                                        <div class="fs-6 text-dark">@Model.Salaries</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class=" form-label fw-semibold text-muted small mb-1">Assignments</label>

                                        <div class="fs-6 text-dark">@Model.Assignments</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class=" form-label fw-semibold text-muted small mb-1">Timetables</label>

                                        <div class="fs-6 text-dark">@Model.Timetables</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class=" form-label fw-semibold text-muted small mb-1">ClassSubjects</label>

                                        <div class="fs-6 text-dark">@Model.ClassSubjects</div>
                                    </div>
                                    <div class="mb-3">
                                        <label class=" form-label fw-semibold text-muted small mb-1">Department</label>

                                        <div class="fs-6 text-dark">@Model.Department</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4 text-center">
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>

    </div>

</div>


