@model StudentEditVM
@{
    ViewData["Title"] = "Edit Student";
}

<style>
    /* Dark theme labels */
    .form-label {
        color: #2c3e50;
        font-weight: 600;
        font-size: 0.95rem;
    }

        .form-label.text-muted {
            color: #7b8a8b !important;
            font-weight: 500;
        }

    /* Layout improvements */
    .card {
        border: 1px solid #e0e0e0;
    }

    .card-header {
        background: linear-gradient(135deg, #f39c12, #e67e22);
        color: white;
        border-bottom: 2px solid #d35400;
    }

    .section-divider {
        border-top: 2px solid #ecf0f1;
        margin: 25px 0;
       
    }

    .section-title {
        color: #34495e;
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 2px solid #3498db;
    }

    /* Field indicators */
    .editable-indicator {
        color: #3498db;
        font-weight: bold;
        margin-right: 5px;
    }

    .required-indicator {
        color: #e74c3c;
        font-weight: bold;
    }

    /* Better spacing */
    .form-control:not([readonly]) {
        border: 1px solid #bdc3c7;
        transition: border 0.3s;
    }

        .form-control:not([readonly]):focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    /* Readonly fields */
    .form-control[readonly] {
        background-color: #f8f9fa;
        border-color: #ecf0f1;
        color: #7f8c8d;
    }

    /* Legend box */
    .legend-box {
        background: linear-gradient(to right, #f8f9fa, #ecf0f1);
        border: 1px solid #bdc3c7;
        border-radius: 8px;
        padding: 15px;
        margin-top: 20px;
    }

</style>

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Student Information</h5>
            <small><i class="bi bi-info-circle"></i> Academic details are locked after creation</small>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="StudentId" />

            <div class="card-body">
                <!-- Validation Summary -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <h6><i class="bi bi-exclamation-triangle"></i> Please fix the following errors:</h6>
                        <ul class="mb-0">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- ==================== SECTION 1: BASIC INFORMATION ==================== -->
                <div class="section-title">
                    <i class="bi bi-person-badge"></i> Basic Information
                </div>

                <div class="row g-3">
                    <!-- Editable Fields -->
                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Student Name
                            <span class="required-indicator">*</span>
                        </label>
                        <input asp-for="StudentName" class="form-control" />
                        <span asp-validation-for="StudentName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Arabic Name
                        </label>
                        <input asp-for="ArabicStudentName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Bangla Name
                        </label>
                        <input asp-for="BanglaStudentName" class="form-control" />
                    </div>

                    <!-- Non-Editable Fields -->
                    <div class="col-md-6">
                        <label class="form-label text-muted">
                            <i class="bi bi-lock"></i> Registration No
                        </label>
                        <input type="text" class="form-control"
                               value="@Model.RegNo" readonly />
                    </div>
                </div>

                <!-- ==================== SECTION 2: ACADEMIC INFORMATION ==================== -->
                <div class="section-divider"></div>
                <div class="section-title">
                    <i class="bi bi-journal-bookmark"></i> Academic Information
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">
                            <i class="bi bi-lock"></i> Department
                        </label>
                        <input type="text" class="form-control"
                               value="@Model.DepartmentName" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-muted">
                            <i class="bi bi-lock"></i> Class
                        </label>
                        <input type="text" class="form-control"
                               value="@Model.ClassName" readonly />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label text-muted">
                            <i class="bi bi-lock"></i> Section
                        </label>
                        <input type="text" class="form-control"
                               value="@Model.SectionName" readonly />
                    </div>
                </div>

                <!-- ==================== SECTION 3: PERSONAL DETAILS ==================== -->
                <div class="section-divider"></div>
                <div class="section-title">
                    <i class="bi bi-person-vcard"></i> Personal Details
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Admission Date
                        </label>
                        <input asp-for="AdmissionDate" type="date" class="form-control" />
                        <span asp-validation-for="AdmissionDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Date of Birth
                        </label>
                        <input asp-for="DOB" type="date" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Gender
                        </label>
                        <select asp-for="Gender" class="form-control">
                            <option value="">Select Gender</option>
                            <option value="0">Male</option>
                            <option value="1">Female</option>
                            <option value="2">Other</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Blood Group
                        </label>
                        <input asp-for="BloodGroup" class="form-control" placeholder="A+, B-, etc." />
                    </div>
                </div>

                <!-- ==================== SECTION 4: FAMILY INFORMATION ==================== -->
                <div class="section-divider"></div>
                <div class="section-title">
                    <i class="bi bi-people"></i> Family Information
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Father's Name
                        </label>
                        <input asp-for="FatherName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Father's Phone
                        </label>
                        <input asp-for="FatherPhone" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Mother's Name
                        </label>
                        <input asp-for="MotherName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Mother's Phone
                        </label>
                        <input asp-for="MotherPhone" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Guardian Name
                        </label>
                        <input asp-for="GuardianName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Guardian Phone
                        </label>
                        <input asp-for="GuardianPhone" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Guardian Email
                        </label>
                        <input asp-for="GuardianEmail" type="email" class="form-control" />
                    </div>
                </div>

                <!-- ==================== SECTION 5: ADDRESS & CONTACT ==================== -->
                <div class="section-divider"></div>
                <div class="section-title">
                    <i class="bi bi-geo-alt"></i> Address & Contact Information
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Address
                        </label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> City
                        </label>
                        <input asp-for="City" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted">
                            <i class="bi bi-lock"></i> Country
                        </label>
                        <input type="text" class="form-control"
                               value="@Model.Country" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Emergency Contact Name
                        </label>
                        <input asp-for="EmergencyContactName" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Emergency Phone
                        </label>
                        <input asp-for="EmergencyPhone" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Medical Notes
                        </label>
                        <textarea asp-for="MedicalNotes" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <!-- ==================== SECTION 6: PREVIOUS ACADEMIC ==================== -->
                <div class="section-divider"></div>
                <div class="section-title">
                    <i class="bi bi-mortarboard"></i> Previous Academic History
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">
                            <i class="bi bi-lock"></i> Previous School
                        </label>
                        <input type="text" class="form-control"
                               value="@Model.PreviousSchoolName" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted">
                            <i class="bi bi-lock"></i> Previous Result
                        </label>
                        <input type="text" class="form-control"
                               value="@Model.PreviousResult" readonly />
                    </div>
                </div>

                <!-- ==================== SECTION 7: FILES & DOCUMENTS ==================== -->
                <div class="section-divider"></div>
                <div class="section-title">
                    <i class="bi bi-files"></i> Files & Documents
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Profile Image
                        </label>
                        <input asp-for="ProfileImage" type="file" class="form-control" />
                        @if (!string.IsNullOrEmpty(Model.ExistingProfileImageUrl))
                        {
                            <div class="mt-2">
                                <small class="text-success">
                                    <i class="bi bi-check-circle"></i> Current file:
                                    <a href="@Model.ExistingProfileImageUrl" target="_blank">View</a>
                                </small>
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Document
                        </label>
                        <input asp-for="DocumentFile" type="file" class="form-control" />
                        @if (!string.IsNullOrEmpty(Model.ExistingDocumentUrl))
                        {
                            <div class="mt-2">
                                <small class="text-success">
                                    <i class="bi bi-check-circle"></i> Current file:
                                    <a href="@Model.ExistingDocumentUrl" target="_blank">View</a>
                                </small>
                            </div>
                        }
                    </div>
                </div>

                <!-- ==================== SECTION 8: STATUS ==================== -->
                <div class="section-divider"></div>
                <div class="section-title">
                    <i class="bi bi-clipboard-check"></i> Status Information
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-check mt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label class="form-check-label">
                                <span class="editable-indicator">•</span> Active Student
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Leaving Date
                        </label>
                        <input asp-for="LeavingDate" type="date" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">
                            <span class="editable-indicator">•</span> Leaving Reason
                        </label>
                        <input asp-for="LeavingReason" class="form-control" />
                    </div>
                </div>

                <!-- ==================== LEGEND ==================== -->
                <div class="legend-box">
                    <div class="row">
                        <div class="col-md-6">
                            <small class="text-dark"><i class="bi bi-info-circle"></i> <strong>Field Indicators:</strong></small><br>
                            <small><span class="editable-indicator">•</span> Editable field</small><br>
                            <small><span class="required-indicator">*</span> Required field</small><br>
                            <small><i class="bi bi-lock text-muted"></i> Read only (cannot be changed)</small>
                        </div>
                        <div class="col-md-6">
                            <small class="text-dark"><i class="bi bi-lightbulb"></i> <strong>Tips:</strong></small><br>
                            <small>• Only fields with <span class="editable-indicator">•</span> can be modified</small><br>
                            <small>• Academic information is locked after student creation</small><br>
                            <small>• Required fields are marked with <span class="required-indicator">*</span></small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light">
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <div>
                        <button type="reset" class="btn btn-outline-warning">
                            <i class="bi bi-arrow-clockwise"></i> Reset
                        </button>
                        <button type="submit" class="btn btn-success ms-2">
                            <i class="bi bi-check-circle"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}