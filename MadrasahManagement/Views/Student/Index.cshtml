@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container-fluid mt-4">

    <!-- ================= HEADER ================= -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">🎓 Student Management</h3>
            <small class="text-muted">All registered students</small>
        </div>

        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-circle"></i> New Student
        </a>
    </div>

    <!-- ================= SEARCH & FILTER ================= -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <input type="text" id="searchBox" class="form-control"
                           placeholder="Search by Name / Reg No / Phone" />
                </div>

                <div class="col-md-3">
                    <select id="departmentFilter" class="form-select">
                        <option value="">All Departments</option>
                        @foreach (var d in ViewBag.Departments)
                        {
                            <option value="@d.DepartmentName">@d.DepartmentName</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <select id="classFilter" class="form-select">
                        <option value="">All Classes</option>
                        <!-- Classes will be loaded dynamically via JavaScript -->
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= TABLE ================= -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0" id="studentTable">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Student</th>
                        <th>Reg No</th>
                        <th data-column="department">Department</th>
                        <th data-column="class">Class</th>
                        <th>Section</th>
                        <th>Guardian</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sl = 1;
                    }
                    @foreach (var s in Model)
                    {
                        <tr data-department="@s.Department?.DepartmentName"
                            data-class="@s.Class?.ClassName"
                            data-section="@s.Section?.SectionName">
                            <td>@sl</td>

                            <!-- Student -->
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(s.ProfileImageUrl) ? "/images/avatar.png" : s.ProfileImageUrl)"
                                         class="rounded-circle me-2"
                                         width="40" height="40" />

                                    <div>
                                        <div class="fw-semibold">@s.StudentName</div>
                                        <small class="text-muted">@s.ArabicStudentName</small>
                                    </div>
                                </div>
                            </td>

                            <!-- Reg -->
                            <td>
                                <span class="badge bg-primary">@s.RegNo</span>
                            </td>

                            <!-- Academic -->
                            <td>
                                <div class="fw-semibold">@s.Department?.DepartmentName</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@s.Class?.ClassName</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@s.Section?.SectionName</div>
                            </td>

                            <!-- Guardian -->
                            <td>
                                <div>@s.GuardianName</div>
                                <small class="text-muted">@s.GuardianPhone</small>
                            </td>

                            <!-- Status -->
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@s.StudentId"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="Edit" asp-route-id="@s.StudentId"
                                   class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-action="Delete" asp-route-id="@s.StudentId"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure?')">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                        sl++;
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center p-4 text-muted">
                    No student found.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Get unique classes by department
        let classesByDepartment = {};
        @foreach (var dept in ViewBag.Departments)
        {
                <text>
                    classesByDepartment['@dept.DepartmentName'] = [];
                </text>
        }

        // Populate classes from table rows
        $('#studentTable tbody tr').each(function() {
            var dept = $(this).data('department');
            var cls = $(this).data('class');

            if (dept && cls) {
                if (!classesByDepartment[dept]) {
                    classesByDepartment[dept] = [];
                }
                if (!classesByDepartment[dept].includes(cls)) {
                    classesByDepartment[dept].push(cls);
                }
            }
        });

        // 🔍 Search
        $("#searchBox").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#studentTable tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });

        // 🎓 Department Filter
        $("#departmentFilter").on("change", function () {
            var selectedDept = $(this).val();

            // Update class filter options
            updateClassFilter(selectedDept);

            // Filter table rows
            filterTableByDepartment(selectedDept);
        });

        // 🏫 Class Filter
        $("#classFilter").on("change", function () {
            var selectedClass = $(this).val();
            var selectedDept = $("#departmentFilter").val();

            // Filter table rows
            filterTableByClass(selectedDept, selectedClass);
        });

        // Update class filter options based on selected department
        function updateClassFilter(department) {
            var classFilter = $("#classFilter");
            classFilter.html('<option value="">All Classes</option>');

            if (department && classesByDepartment[department]) {
                // Sort classes alphabetically
                classesByDepartment[department].sort().forEach(function(cls) {
                    classFilter.append('<option value="' + cls + '">' + cls + '</option>');
                });
            } else if (!department) {
                // Show all unique classes if no department selected
                var allClasses = [];
                Object.values(classesByDepartment).forEach(function(classes) {
                    classes.forEach(function(cls) {
                        if (!allClasses.includes(cls)) {
                            allClasses.push(cls);
                        }
                    });
                });

                allClasses.sort().forEach(function(cls) {
                    classFilter.append('<option value="' + cls + '">' + cls + '</option>');
                });
            }

            // Reset class selection
            classFilter.val("");
        }

        // Filter table by department
        function filterTableByDepartment(department) {
            if (!department) {
                // Show all rows
                $("#studentTable tbody tr").show();
                return;
            }

            $("#studentTable tbody tr").each(function() {
                var rowDept = $(this).data('department');
                $(this).toggle(rowDept === department);
            });
        }

        // Filter table by class (and optionally department)
        function filterTableByClass(department, className) {
            if (!className) {
                // If no class selected, filter only by department
                filterTableByDepartment(department);
                return;
            }

            $("#studentTable tbody tr").each(function() {
                var rowDept = $(this).data('department');
                var rowClass = $(this).data('class');

                if (department) {
                    // Filter by both department and class
                    $(this).toggle(rowDept === department && rowClass === className);
                } else {
                    // Filter only by class
                    $(this).toggle(rowClass === className);
                }
            });
        }

        // Initialize: Load all classes initially
        $(document).ready(function() {
            updateClassFilter("");
        });
    </script>
}