@using MadrasahManagement.ViewModels
@model StudentRegisterViewModel

<h2>Student Registration</h2>

<form asp-action="RegisterStudent" method="post">

    <input asp-for="StudentName" class="form-control" placeholder="Student Name" />
    <span asp-validation-for="StudentName"></span>

    <input asp-for="RegNo" class="form-control" placeholder="Registration No" />
    <span asp-validation-for="RegNo"></span>

    <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
    <span asp-validation-for="Password"></span>

    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
    <span asp-validation-for="ConfirmPassword"></span>

    <button class="btn btn-primary mt-3">Register</button>

    <a asp-action="LoginStudent" class="btn btn-link">Already have account? Login</a>
</form>
