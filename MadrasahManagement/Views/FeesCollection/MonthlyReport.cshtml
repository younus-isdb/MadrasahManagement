@model List<FeeCollection>

@{
    ViewData["Title"] = "Monthly Report";
    var monthNames = new[] { "January", "February", "March", "April", "May", "June",
                           "July", "August", "September", "October", "November", "December" };
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="fas fa-calendar-alt me-2"></i>Monthly Collection Report</h3>
        <div class="btn-group" role="group">
            <a asp-action="MonthlyReport" asp-route-monthDate="@ViewBag.PrevMonth"
               class="btn btn-outline-secondary">
                <i class="fas fa-chevron-left"></i> Previous Month
            </a>
            <button class="btn btn-primary" disabled>@ViewBag.Month</button>
            <a asp-action="MonthlyReport" asp-route-monthDate="@ViewBag.NextMonth"
               class="btn btn-outline-secondary">
                Next Month <i class="fas fa-chevron-right"></i>
            </a>
        </div>
    </div>

    <!-- Month Selector -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label>Select Month</label>
                    <input type="month" name="monthDate" class="form-control"
                           value="@ViewBag.StartDate.Substring(0, 7)" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i> Show
                    </button>
                </div>
                <div class="col-md-6 text-end">
                    <a asp-action="CollectionReport" class="btn btn-outline-info">
                        <i class="fas fa-chart-line me-1"></i> Detailed Report
                    </a>
                    <button onclick="window.print()" class="btn btn-outline-secondary">
                        <i class="fas fa-print me-1"></i> Print
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Summary -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h6 class="card-title">Total Collections</h6>
                    <h2>৳@ViewBag.TotalAmount.ToString("N2")</h2>
                    <p class="mb-0">@ViewBag.TotalTransactions transactions in @ViewBag.Month</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h6 class="card-title">Daily Average</h6>
                    @{
                        var daysInMonth = DateTime.DaysInMonth(
                        DateTime.Parse(ViewBag.StartDate).Year,
                        DateTime.Parse(ViewBag.StartDate).Month);
                        var dailyAvg = daysInMonth > 0 ? (decimal)ViewBag.TotalAmount / daysInMonth : 0;
                    }
                    <h2>৳@dailyAvg.ToString("N2")</h2>
                    <p class="mb-0">Average per day in @ViewBag.Month</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Collections Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-list me-2"></i>
                Collections for @ViewBag.Month
                <span class="badge bg-secondary ms-2">@Model.Count</span>
            </h5>
            <span class="text-muted">
                @DateTime.Parse(ViewBag.StartDate).ToString("dd MMM") - @DateTime.Parse(ViewBag.EndDate).ToString("dd MMM yyyy")
            </span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr class="table-light">
                            <th>Date</th>
                            <th>Receipt No</th>
                            <th>Student</th>
                            <th>Class</th>
                            <th>Fee Type</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.DatePaid.ToString("dd-MMM")</td>
                                <td>
                                    <strong class="text-primary">@item.ReceiptNumber</strong>
                                </td>
                                <td>@item.Student?.StudentName</td>
                                <td>@item.Student?.Class?.ClassName</td>
                                <td>
                                    <span class="badge bg-info">@item.FeeType?.Name</span>
                                </td>
                                <td class="fw-bold">৳@item.AmountPaid.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-secondary">@item.PaymentMethod</span>
                                </td>
                                <td>
                                    <a asp-action="Receipt" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-receipt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Model.Any())
                    {
                        <tfoot class="table-secondary">
                            <tr>
                                <th colspan="5" class="text-end">Total:</th>
                                <th class="fw-bold">৳@ViewBag.TotalAmount.ToString("N2")</th>
                                <th colspan="2">@ViewBag.TotalTransactions transactions</th>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No collections found</h4>
                    <p class="text-muted mb-4">No fee collections for @ViewBag.Month</p>
                    <a asp-action="CollectFee" class="btn btn-primary">
                        <i class="fas fa-plus-circle me-1"></i>Add Collection
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Simple Summary -->
    @if (Model.Any())
    {
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-money-bill-wave me-2"></i>By Fee Type</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var group in Model.GroupBy(c => c.FeeType?.Name).OrderByDescending(g => g.Sum(c => c.AmountPaid)))
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@group.Key</span>
                                <span class="fw-bold">৳@group.Sum(c => c.AmountPaid).ToString("N0")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-credit-card me-2"></i>By Payment Method</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var group in Model.GroupBy(c => c.PaymentMethod).OrderByDescending(g => g.Sum(c => c.AmountPaid)))
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@group.Key</span>
                                <span class="fw-bold">৳@group.Sum(c => c.AmountPaid).ToString("N0")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-graduation-cap me-2"></i>By Class</h6>
                    </div>
                    <div class="card-body">
                        @foreach (var group in Model.Where(c => c.Student?.Class != null)
                                            .GroupBy(c => c.Student.Class.ClassName)
                                            .OrderByDescending(g => g.Sum(c => c.AmountPaid)))
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@group.Key</span>
                                <span class="fw-bold">৳@group.Sum(c => c.AmountPaid).ToString("N0")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

