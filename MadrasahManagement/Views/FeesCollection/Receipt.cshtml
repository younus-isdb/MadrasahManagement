@model FeeCollection

@{
    decimal totalFee = Model.FeeType?.Amount ?? 0;
    decimal paid = Model.AmountPaid;
    decimal due = totalFee - paid;
}

<div class="container" id="receipt">
    <div class="text-center mb-4">
        <h3>School Name</h3>
        <h5>Fee Receipt</h5>
    </div>

    <div class="row">
        <div class="col-md-6">
            <p><strong>Receipt No:</strong> @Model.ReceiptNumber</p>
            <p><strong>Date:</strong> @Model.DatePaid.ToString("dd-MMM-yyyy")</p>
        </div>
        <div class="col-md-6 text-end">
            <p><strong>Student ID:</strong> @Model.StudentId</p>
            <p>
                <strong>Payment Status:</strong>
                <span class="@(due > 0 ? "text-warning fw-bold" : "text-success fw-bold")">
                    @(due > 0 ? "Partial Paid" : "Paid")
                </span>
            </p>
        </div>
    </div>

    <hr />

    <div class="mb-4">
        <h5>Student Details</h5>
        <p><strong>Name:</strong> @Model.Student?.StudentName</p>
        <p><strong>Class:</strong> @Model.Student?.Class?.ClassName</p>
        <p><strong>Roll No:</strong> @Model.Student?.RegNo</p>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Fee Type</th>
                <th>Amount (৳)</th>
                <th>Payment Method</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.FeeType?.Name</td>
                <td>৳@paid</td>
                <td>@Model.PaymentMethod</td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2" class="text-end">Total Fee:</th>
                <th>৳@totalFee</th>
            </tr>
            <tr>
                <th colspan="2" class="text-end">Paid:</th>
                <th>৳@paid</th>
            </tr>
            <tr>
                <th colspan="2" class="text-end">Due:</th>
                <th class="@(due > 0 ? "text-danger fw-bold" : "text-success fw-bold")">
                    ৳@(due > 0 ? due : 0)
                </th>
            </tr>
        </tfoot>
    </table>

