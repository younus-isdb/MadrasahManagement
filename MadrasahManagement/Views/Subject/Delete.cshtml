@* Views/Subject/Delete.cshtml *@
@model Subject

@{
    ViewData["Title"] = "Delete Subject";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-danger">Delete Subject</h6>
        </div>
        <div class="card-body">
            @if (ViewBag.HasDependencies)
            {
                <div class="alert alert-danger">
                    <h5><i class="fas fa-exclamation-triangle"></i> Cannot Delete Subject</h5>
                    <p>@ViewBag.DependencyMessage</p>
                    <p>This subject has the following dependencies:</p>
                    <ul>
                        <li>Assigned to teachers</li>
                        <li>Used in class-subject relationships</li>
                        <li>Associated with point conditions</li>
                        <li>Used in exam fee collections</li>
                        <li>Scheduled in exam routines</li>
                    </ul>
                    <p>Please remove all dependencies before deleting this subject.</p>
                </div>

                <div class="form-group">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                </div>
            }
            else
            {
                <h4 class="text-danger">Are you sure you want to delete this subject?</h4>
                <div class="alert alert-warning">
                    <p><strong>This action cannot be undone.</strong></p>
                    <p>All related data will be permanently removed.</p>
                </div>

                <div class="row mt-4">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Subject Name:</dt>
                            <dd class="col-sm-8">@Model.SubjectName</dd>

                            <dt class="col-sm-4">Subject Code:</dt>
                            <dd class="col-sm-8">@Model.SubjectCode</dd>

                            <dt class="col-sm-4">Class:</dt>
                            <dd class="col-sm-8">@Model.Class?.ClassName</dd>

                            <dt class="col-sm-4">Department:</dt>
                            <dd class="col-sm-8">@Model.Department?.DepartmentName</dd>

                            <dt class="col-sm-4">Type:</dt>
                            <dd class="col-sm-8">
                                @(Model.IsOptional ? "Optional" : "Mandatory")
                            </dd>
                        </dl>
                    </div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SubjectId" />

                    <div class="form-group">
                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i> Yes, Delete Subject
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>