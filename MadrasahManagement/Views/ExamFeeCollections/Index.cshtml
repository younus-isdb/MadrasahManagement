@model IEnumerable<MadrasahManagement.Dto.ExamFeesReadDto>

@{
    ViewData["Title"] = "Exam Fees";
}

<h2>Exam Fees</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Exam Fee</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Education Year</th>
            <th>Class</th>
            <th>Exam</th>
            <th>Amount</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fee in Model)
        {
            <tr>
                <td>@fee.EducationYear</td>
                <td>@fee.ClassName</td>
                <td>@fee.ExamName</td>
                <td>@fee.ExamAmount</td>
                <td>
                    <a asp-action="Details" asp-route-id="@fee.ExamFeeId" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@fee.ExamFeeId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="Delete" asp-route-id="@fee.ExamFeeId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
