@model MadrasahManagement.Dto.ExamFeesCreateDto

@{
    ViewData["Title"] = "Create Exam Fee Collection";
}

<h2>@ViewData["Title"]</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    </div>
}

<form asp-action="Create" method="post" id="createForm">
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label asp-for="EducationYear"></label>
                <input asp-for="EducationYear" class="form-control" id="educationYear" />
                <span asp-validation-for="EducationYear" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <label asp-for="DepartmentId"></label>
                <select asp-for="DepartmentId" class="form-control" id="departmentSelect">
                    <option value="">-- Select Department --</option>
                    @foreach (var dept in ViewBag.Departments)
                    {
                        <option value="@dept.Value" selected="@(dept.Value == Model.DepartmentId.ToString())">
                            @dept.Text
                        </option>
                    }
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <label asp-for="ClassId"></label>
                <select asp-for="ClassId" class="form-control" id="classSelect">
                    <option value="">-- Select Class --</option>
                    @foreach (var cls in ViewBag.Classes)
                    {
                        <option value="@cls.Value" selected="@(cls.Value == Model.ClassId.ToString())">
                            @cls.Text
                        </option>
                    }
                </select>
                <span asp-validation-for="ClassId" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <label asp-for="ExamId"></label>
                <select asp-for="ExamId" class="form-control" id="examSelect">
                    <option value="">-- Select Exam --</option>
                    @foreach (var exam in ViewBag.Exams)
                    {
                        <option value="@exam.Value" selected="@(exam.Value == Model.ExamId.ToString())">
                            @exam.Text
                        </option>
                    }
                </select>
                <span asp-validation-for="ExamId" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="ExamAmount"></label>
                <input asp-for="ExamAmount" class="form-control" id="examAmount" />
                <span asp-validation-for="ExamAmount" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Hidden field for ExamFeeId if it exists -->
    <input type="hidden" id="examFeeId" name="ExamFeeId" value="" />

    <div class="card mt-4">
        <div class="card-header">
            <h5>Student Fee Collections</h5>
            <button type="button" class="btn btn-success btn-sm" onclick="addRow()">Add Student</button>
        </div>
        <div class="card-body">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Fee Amount</th>
                        <th>Total Subjects</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    @if (Model.FeeCollections != null && Model.FeeCollections.Count > 0)
                    {
                        for (int i = 0; i < Model.FeeCollections.Count; i++)
                        {
                            <tr>
                                <td>
                                    <select name="FeeCollections[@i].StudentId" class="form-control studentSelect">
                                        <option value="">-- Select Student --</option>
                                        @foreach (var student in ViewBag.AllStudents)
                                        {
                                            <option value="@student.StudentId"
                                                    selected="@(student.StudentId == Model.FeeCollections[i].StudentId)">
                                                @student.StudentName
                                            </option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="FeeCollections[@i].ExamFeeAmount"
                                           class="form-control feeAmount"
                                           value="@Model.FeeCollections[i].ExamFeeAmount" step="0.01" />
                                </td>
                                <td>
                                    <input type="number" name="FeeCollections[@i].TotalSubject"
                                           class="form-control"
                                           value="@Model.FeeCollections[i].TotalSubject" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                                        Remove
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save Collections</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        let rowCount = @(Model.FeeCollections?.Count ?? 0);

        // Initialize page
        $(document).ready(function() {
            // Add initial row if no rows exist
            if (rowCount === 0) {
                addRow();
            }

            // Setup event listeners
            setupEventListeners();

            // Auto-load exam fee if all fields are filled
            autoLoadExamFeeIfPossible();
        });

        // Setup all event listeners
        function setupEventListeners() {
            // Department change - load classes
            $('#departmentSelect').change(function() {
                const departmentId = $(this).val();
                if (!departmentId) {
                    $('#classSelect').html('<option value="">-- Select Department First --</option>');
                    $('.studentSelect').html('<option value="">-- Select Department First --</option>');
                    return;
                }

                // Load classes for selected department
                $.get(`/ExamFeeCollections/GetClassesByDepartment?departmentId=${departmentId}`, function(classes) {
                    let options = '<option value="">-- Select Class --</option>';
                    classes.forEach(cls => {
                        // Check if this class was previously selected
                        const selected = cls.classId == @Model.ClassId ? 'selected' : '';
                        options += `<option value="${cls.classId}" ${selected}>${cls.className}</option>`;
                    });

                    $('#classSelect').html(options);

                    // If class was previously selected, load its students
                    const selectedClassId = @Model.ClassId;
                    if (selectedClassId > 0) {
                        $('#classSelect').val(selectedClassId);
                        loadStudents(selectedClassId);
                    }
                });
            });

            // Class change - load students
            $('#classSelect').change(function() {
                const classId = $(this).val();
                if (!classId) {
                    $('.studentSelect').html('<option value="">-- Select Class First --</option>');
                    return;
                }

                loadStudents(classId);
                autoLoadExamFeeIfPossible();
            });

            // Auto-load exam fee when all three are selected
            $('#examSelect, #educationYear').change(function() {
                autoLoadExamFeeIfPossible();
            });

            // Exam amount change - do NOT auto-fill student rows
            $('#examAmount').on('input', function() {
                // Student rows will have their own amounts
            });
        }

        // Auto-load exam fee if all required fields are filled
        function autoLoadExamFeeIfPossible() {
            const classId = $('#classSelect').val();
            const examId = $('#examSelect').val();
            const educationYear = $('#educationYear').val();

            if (classId && examId && educationYear) {
                loadExamFee(classId, examId, educationYear);
            }
        }

        // Load students for selected class
        function loadStudents(classId) {
            $.get(`/ExamFeeCollections/GetStudentsByClass?classId=${classId}`, function(students) {
                // Update all student dropdowns
                $('.studentSelect').each(function() {
                    const select = $(this);
                    const currentValue = select.val();

                    let options = '<option value="">-- Select Student --</option>';
                    students.forEach(student => {
                        options += `<option value="${student.studentId}">${student.studentName}</option>`;
                    });

                    select.html(options);

                    // Try to restore previous selection
                    if (currentValue) {
                        select.val(currentValue);
                    }
                });
            });
        }

        // Load exam fee amount (ONLY in the examAmount field)
        function loadExamFee(classId, examId, educationYear) {
            $.get(`/ExamFeeCollections/GetExamFeeByClassAndExam?classId=${classId}&examId=${examId}&educationYear=${educationYear}`,
                function(result) {
                    if (result.success) {
                        // Update the main ExamAmount field
                        $('#examAmount').val(result.amount);

                        // Store ExamFeeId if available
                        if (result.examFeeId) {
                            $('#examFeeId').val(result.examFeeId);
                        }

                        // Optional: Show message
                        console.log('Exam fee auto-loaded:', result.amount);
                    } else {
                        // Don't clear if user already entered amount
                        if (!$('#examAmount').val()) {
                            $('#examAmount').val('');
                        }
                        $('#examFeeId').val(''); // Clear ExamFeeId
                    }
                }
            );
        }

        // Add new row
        function addRow() {
            const tbody = $('#tableBody');
            const rowIndex = rowCount++;

            const row = $(`
                <tr>
                    <td>
                        <select name="FeeCollections[${rowIndex}].StudentId" class="form-control studentSelect">
                            <option value="">-- Select Student --</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" name="FeeCollections[${rowIndex}].ExamFeeAmount"
                               class="form-control feeAmount" value="${$('#examAmount').val() || ''}"
                               step="0.01" placeholder="Enter fee amount" />
                    </td>
                    <td>
                        <input type="number" name="FeeCollections[${rowIndex}].TotalSubject"
                               class="form-control" value="0" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                            Remove
                        </button>
                    </td>
                </tr>
            `);

            tbody.append(row);

            // Load students for this row if class is selected
            const classId = $('#classSelect').val();
            if (classId) {
                updateStudentDropdown(row.find('.studentSelect'), classId);
            }
        }

        // Update student dropdown for a specific select
        function updateStudentDropdown(selectElement, classId) {
            $.get(`/ExamFeeCollections/GetStudentsByClass?classId=${classId}`, function(students) {
                let options = '<option value="">-- Select Student --</option>';
                students.forEach(student => {
                    options += `<option value="${student.studentId}">${student.studentName}</option>`;
                });

                selectElement.html(options);
            });
        }

        // Remove row
        function removeRow(button) {
            $(button).closest('tr').remove();
            updateRowIndexes();
        }

        // Update row indexes after removal
        function updateRowIndexes() {
            const rows = $('#tableBody tr');
            rowCount = 0;

            rows.each(function(index) {
                const row = $(this);

                // Update all input names
                row.find('.studentSelect').attr('name', `FeeCollections[${index}].StudentId`);
                row.find('.feeAmount').attr('name', `FeeCollections[${index}].ExamFeeAmount`);
                row.find('input[type="number"]:last').attr('name', `FeeCollections[${index}].TotalSubject`);

                rowCount++;
            });
        }

        // Initial setup - if department is already selected, load its classes
        const departmentId = $('#departmentSelect').val();
        if (departmentId) {
            // Trigger department change to load classes
            $('#departmentSelect').trigger('change');
        }
    </script>
}