@model IEnumerable<MadrasahManagement.Dto.SeatPlanReadDto>

<div class="container mt-4" id="seatPlanPrintableArea">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="text-center w-100">
            <h2 class="text-primary fw-bold">Halishahar Mohila Madrasa</h2>
            <h4 class="text-secondary">Exam Seat Plan Report</h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="fas fa-plus"></i> Create New Plan
            </a>
            <button type="button" class="btn btn-info shadow-sm" onclick="printSeatPlan()">Print Seat Plan</button>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var roomGroup in Model.GroupBy(x => new { x.ExamDate, x.RoomNumber }))
        {
            <div class="card mb-4 shadow border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between py-3">
                    <span class="h6 mb-0">Date: @roomGroup.Key.ExamDate.ToString("dd MMM yyyy")</span>
                    <span class="h6 mb-0">Room: @roomGroup.Key.RoomNumber</span>
                </div>
                <div class="card-body p-3">
                    @{
                        var students = roomGroup.ToList();
                        int benchCount = 1;

                        for (int i = 0; i < students.Count; i += 2)
                        {
                            <div class="row mb-3 print-row">
                                <!-- Left Seat -->
                                <div class="col-md-6 seat-card">
                                    <div class="p-2 border rounded-2 bg-light position-relative">
                                        <div class="position-absolute top-0 end-0 p-1">
                                            <span class="badge bg-info text-dark">Left Seat</span>
                                        </div>
                                        <h5 class="text-primary mb-1">@students[i].StudentName</h5>
                                        <p class="mb-1 small"><strong>Reg:</strong> @students[i].RegNo</p>
                                        <div class="d-flex justify-content-between small text-muted">
                                            <span><strong>Class:</strong> @students[i].ClassName</span>
                                            <span><strong>Dept:</strong> @students[i].DepartmentName</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Seat -->
                                <div class="col-md-6 seat-card">
                                    @if ((i + 1) < students.Count)
                                    {
                                        <div class="p-2 border rounded-2 bg-light position-relative">
                                            <div class="position-absolute top-0 end-0 p-1">
                                                <span class="badge bg-info text-dark">Right Seat</span>
                                            </div>
                                            <h5 class="text-primary mb-1">@students[i + 1].StudentName</h5>
                                            <p class="mb-1 small"><strong>Reg:</strong> @students[i + 1].RegNo</p>
                                            <div class="d-flex justify-content-between small text-muted">
                                                <span><strong>Class:</strong> @students[i + 1].ClassName</span>
                                                <span><strong>Dept:</strong> @students[i + 1].DepartmentName</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="p-2 border rounded-2 bg-white text-center text-muted d-flex align-items-center justify-content-center" style="min-height:100px;">
                                            <em>Empty Seat</em>
                                        </div>
                                    }
                                </div>
                            </div>
                            benchCount++;
                        }
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <h5>No Seat Plans Available!</h5>
            <a asp-action="Create" class="btn btn-primary mt-2">Create New Plan Now</a>
        </div>
    }
</div>

<style>
    /* PRINT STYLES */
    @@media print {
        body *

    {
        visibility: hidden;
    }

    #seatPlanPrintableArea, #seatPlanPrintableArea * {
        visibility: visible;
    }

    #seatPlanPrintableArea {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
    }

    .seat-card {
        padding: 5px !important;
    }

    .print-row {
        display: flex !important;
        flex-wrap: nowrap !important;
        page-break-inside: avoid;
    }

    .seat-card {
        flex: 1;
    }
    /* Remove buttons in print */
    .btn {
        display: none !important;
    }

    }
</style>

<script>
    function printSeatPlan() {
        window.print();
    }
</script>
