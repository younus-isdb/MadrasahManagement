@model MadrasahManagement.Models.SeatPlan

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header bg-warning text-dark">
            <h4>Edit Seat Assignment</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="SeatPlanId" />

                <div class="mb-3">
                    <label>Exam Date</label>
                    <input asp-for="ExamDate" type="date" class="form-control" />
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label>Room No</label>
                        <input asp-for="RoomNumber" class="form-control" />
                    </div>
                    <div class="col">
                        <label>Rows</label>
                        <input asp-for="NumberOfRows" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label>Student</label>
                    <select asp-for="StudentId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Students, "studentId", "studentName"))"></select>
                </div>

                <div class="mb-3">
                    <label>Class</label>
                    <select asp-for="ClassId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Classes, "classId", "className"))"></select>
                </div>

                <div class="mb-3">
                    <label>Department</label>
                    <select asp-for="DepartmentId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Departments, "departmentId", "departmentName"))"></select>
                </div>

                <div class="mb-3">
                    <label>Subject</label>
                    <select asp-for="SubjectId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Subjects, "subjectId", "subjectName"))">
                        <option value="">-- No Subject --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
                    <button type="submit" class="btn btn-success">Update Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>