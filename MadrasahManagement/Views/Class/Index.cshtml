@model IEnumerable<MadrasahManagement.Models.Class>
@{
    ViewData["Title"] = "Classes by Department";

    // Group classes by department
    var classesByDepartment = Model?
        .GroupBy(c => c.Department?.DepartmentName ?? "No Department")
        .OrderBy(g => g.Key)
        ?? Enumerable.Empty<IGrouping<string, Class>>();
}

<h2>Classes by Department</h2>

<div class="d-flex justify-content-between align-items-center mb-4">
    <a class="btn btn-primary" href="/Class/Create">
        <i class="bi bi-plus-circle"></i> Create New Class
    </a>

    <div class="text-muted">
        <i class="bi bi-layers"></i> Total: @Model?.Count() Classes
    </div>
</div>

@if (!classesByDepartment.Any())
{
    <div class="alert alert-info">
        No classes found. Please add some classes first.
    </div>
}
else
{
    @foreach (var departmentGroup in classesByDepartment)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-building"></i> @departmentGroup.Key
                    <span class="badge bg-light text-dark ms-2">
                        @departmentGroup.Count() class(es)
                    </span>
                </h4>
                <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapse-@(departmentGroup.Key.Replace(" ", "-"))">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="collapse-@(departmentGroup.Key.Replace(" ", "-"))">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Class ID</th>
                                    <th>Class Name</th>
                                    <th>Session Year</th>
                                   
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cls in departmentGroup.OrderBy(c => c.ClassName))
                                {
                                    <tr>
                                        <td>@cls.ClassId</td>
                                        <td>@cls.ClassName
                                         </td>
                                       
                                        <td>@cls.SessionYear</td>
                                       
                                       
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a href="/Class/Details/@cls.ClassId"
                                                   class="btn btn-outline-info" title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="/Class/Edit/@cls.ClassId"
                                                   class="btn btn-outline-warning" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="/Class/Delete/@cls.ClassId"
                                                   class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
}