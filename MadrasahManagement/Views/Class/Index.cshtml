@model IEnumerable<MadrasahManagement.Models.Class>
@{
    ViewData["Title"] = "Classes by Department";

    // Group classes by department
    var classesByDepartment = Model?
        .GroupBy(c => c.Department?.DepartmentName ?? "No Department")
        .OrderBy(g => g.Key)
        ?? Enumerable.Empty<IGrouping<string, Class>>();
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
            <i class="fas fa-graduation-cap"></i> @ViewData["Title"]
        </h4>
    </div>
    <div class="card-body">
        <!-- Filter Form -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Department</label>
                @{
                    var selectedDept = ViewBag.SelectedDepartmentId as int?;
                }
                <select name="departmentId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    @if (ViewBag.Departments != null)
                    {
                        var departments = ViewBag.Departments as List<Department>;
                        @if (departments != null)
                        {
                            foreach (var dept in departments)
                            {
                                <option value="@dept.DepartmentId"
                                        selected="@(selectedDept.HasValue && selectedDept.Value == dept.DepartmentId)">
                                    @dept.DepartmentName
                                </option>
                            }
                        }
                    }
                </select>
            </div>
        </form>

        <!-- Create Button -->
        <div class="mb-4">
            <a asp-action="Create" class="btn btn-success">
                <i class="fas fa-plus-circle"></i> Create New Class
            </a>
        </div>

        @if (!classesByDepartment.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> No classes found. Please add some classes first.
            </div>
        }
        else
        {
            @foreach (var departmentGroup in classesByDepartment)
            {
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-building"></i> @departmentGroup.Key
                            <span class="badge bg-light text-dark ms-2">
                                @departmentGroup.Count() class(es)
                            </span>
                        </h5>
                        <button class="btn btn-sm btn-light" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapse-@(departmentGroup.Key.Replace(" ", "-"))">
                            <i class="fas fa-chevron-down"></i>
                        </button>
                    </div>

                    <div class="collapse show" id="collapse-@(departmentGroup.Key.Replace(" ", "-"))">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Class ID</th>
                                            <th>Class Name</th>
                                            <th>Session Year</th>
                                            <th>Subjects</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cls in departmentGroup.OrderBy(c => c.ClassName))
                                        {
                                            <tr>
                                                <td>@cls.ClassId</td>
                                                <td>@cls.ClassName</td>
                                                <td>@cls.SessionYear</td>
                                                <td>
                                                    <span class="badge bg-info">
                                                        @(cls.Subjects?.Count ?? 0) Subjects
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <a asp-action="ClassSubjects" asp-route-id="@cls.ClassId"
                                                           class="btn btn-info btn-sm" title="View Subjects">
                                                            <i class="fas fa-book"></i>Subjects
                                                        </a>
                                                        <a asp-action="Details" asp-route-id="@cls.ClassId"
                                                           class="btn btn-outline-info btn-sm" title="View Details">
                                                            <i class="fas fa-eye"></i>Details
                                                        </a>
                                                        <a asp-action="Edit" asp-route-id="@cls.ClassId"
                                                           class="btn btn-warning btn-sm" title="Edit">
                                                            <i class="fas fa-edit"></i>Edit
                                                        </a>
                                                        <a asp-action="Delete" asp-route-id="@cls.ClassId"
                                                           class="btn btn-danger btn-sm" title="Delete">
                                                            <i class="fas fa-trash"></i>Delete
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto-close other department cards when one opens
        $('.collapse').on('show.bs.collapse', function () {
            $('.collapse.show').not(this).collapse('hide');
        });
    </script>
}