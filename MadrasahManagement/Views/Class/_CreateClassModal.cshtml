@model MadrasahManagement.Models.Class

<form id="classCreateForm" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

   

    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" class="form-control" required>
            <option value="">Select Department</option>
            @foreach (var item in ViewBag.DepartmentList)
            {
                <option value="@item.DepartmentId">@item.DepartmentName</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ClassName" class="form-label"></label>
        <input asp-for="ClassName" class="form-control" placeholder="Enter Class Name" required />
        <span asp-validation-for="ClassName" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create
        </button>

        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle"></i> Close
        </button>
    </div>
</form>

<script>
    $(document).ready(function() {
        $("#classCreateForm").submit(function (e) {
            e.preventDefault();

            var form = $(this);
            var submitBtn = form.find('.btn-primary');
            var originalText = submitBtn.html();

            // Show loading
            submitBtn.html('<span class="spinner-border spinner-border-sm"></span> Creating...').prop('disabled', true);

            $.ajax({
                url: "/Class/CreateModalPost", // CORRECT URL
                type: "POST",
                data: form.serialize(),
                success: function (res) {
                    submitBtn.html(originalText).prop('disabled', false);

                    if (res.success) {
                        $('#classModal').modal('hide');

                        // Get selected department
                        var deptId = $("#classCreateForm [name='DepartmentId']").val();
                        if (deptId && window.parent && window.parent.RefreshClassList) {
                            window.parent.RefreshClassList(deptId);
                        }
                    } else {
                        alert("Failed to create class. Please check the form.");
                    }
                },
                error: function() {
                    submitBtn.html(originalText).prop('disabled', false);
                    alert("Error creating class");
                }
            });
        });
    });
</script>