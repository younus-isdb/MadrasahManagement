@model Class
@{
    ViewData["Title"] = "Class Subjects";
}

<div class="card">
    <div class="card-header bg-info text-white">
        <h4 class="mb-0">
            <i class="fas fa-book"></i> @Model.ClassName - Subjects
        </h4>
    </div>
    <div class="card-body">
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h6>Class Information</h6>
                        <p><strong>Class:</strong> @Model.ClassName</p>
                        <p><strong>Department:</strong> @Model.Department?.DepartmentName</p>
                        <p><strong>Session:</strong> @Model.SessionYear</p>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="AddSubjects" asp-route-id="@Model.ClassId"
                       class="btn btn-success">
                        <i class="fas fa-plus"></i> Add More Subjects
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Classes
                    </a>
                </div>
            </div>
        </div>

        <h5>Subjects List</h5>
        @if (Model.Subjects.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Subject Code</th>
                            <th>Subject Name</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subject in Model.Subjects)
                        {
                            <tr id="subject-@subject.SubjectId">
                                <td>@subject.SubjectId</td>
                                <td>@subject.SubjectCode</td>
                                <td>@subject.SubjectName</td>
                                <td>
                                    @if (subject.IsOptional)
                                    {
                                        <span class="badge bg-warning">Optional</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Mandatory</span>
                                    }
                                </td>
                                <td>
                                    <button onclick="deleteSubject(@Model.ClassId, @subject.SubjectId)"
                                            class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>Delete
                                    </button>
                                    <!-- Add this near other action buttons -->
                                    <a asp-action="AssignTeachers" asp-route-id="@Model.ClassId"
                                       class="btn btn-warning">
                                        <i class="fas fa-chalkboard-teacher"></i> Assign Teachers
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i> No subjects found for this class.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function deleteSubject(classId, subjectId) {
            if (confirm('Are you sure you want to delete this subject?')) {
                fetch(`/Class/DeleteSubject?classId=${classId}&subjectId=${subjectId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById(`subject-${subjectId}`).remove();
                        alert(data.message);
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while deleting the subject.');
                });
            }
        }
    </script>
}