@using MadrasahManagement.Controllers
@model DashboardViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard - Madrasah Management System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #3a86ff;
            --secondary-color: #8338ec;
            --success-color: #38b000;
            --warning-color: #ffbe0b;
            --danger-color: #ff006e;
            --light-bg: #f8f9fa;
            --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --border-radius: 12px;
        }

        body {
            background-color: #f5f7fb;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
            padding-bottom: 40px;
        }

        .dashboard-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.5rem 0;
            border-radius: 0 0 var(--border-radius) var(--border-radius);
            margin-bottom: 2rem;
            box-shadow: 0 4px 12px rgba(58, 134, 255, 0.2);
        }

            .dashboard-header h2 {
                font-weight: 700;
                margin-bottom: 0.5rem;
            }

            .dashboard-header p {
                opacity: 0.9;
                margin-bottom: 0;
            }

        .card {
            border: none;
            border-radius: var(--border-radius);
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
            overflow: hidden;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            }

        .card-title {
            font-weight: 600;
            color: #555;
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }

        .card-value {
            font-size: 2.2rem;
            font-weight: 700;
            margin: 0.5rem 0;
        }

        .attendance-present {
            color: var(--success-color);
        }

        .attendance-absent {
            color: var(--danger-color);
        }

        .attendance-late {
            color: var(--warning-color);
        }

        .stats-card .card-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
        }

        .card-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            opacity: 0.8;
        }

        .attendance-icon {
            color: var(--primary-color);
        }

        .assignments-icon {
            color: var(--warning-color);
        }

        .notices-section {
            margin-top: 2.5rem;
        }

        .section-title {
            color: #444;
            font-weight: 700;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 3px solid var(--primary-color);
            display: inline-block;
        }

        .notice-card {
            border-left: 4px solid var(--primary-color);
            margin-bottom: 1rem;
            transition: all 0.2s;
        }

            .notice-card:hover {
                border-left-width: 6px;
            }

        .notice-title {
            font-weight: 600;
            color: #333;
            margin-bottom: 0.25rem;
        }

        .notice-date {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .notice-content {
            color: #555;
            margin-top: 0.5rem;
            font-size: 0.95rem;
        }

        .badge-new {
            background-color: var(--danger-color);
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
        }

        .empty-state {
            text-align: center;
            padding: 2rem;
            color: #6c757d;
        }

            .empty-state i {
                font-size: 3rem;
                margin-bottom: 1rem;
                opacity: 0.5;
            }

        .quick-links {
            background-color: white;
            border-radius: var(--border-radius);
            padding: 1.5rem;
            box-shadow: var(--card-shadow);
            margin-top: 2rem;
        }

            .quick-links h5 {
                color: #444;
                margin-bottom: 1.2rem;
            }

        .quick-link-item {
            display: flex;
            align-items: center;
            padding: 0.8rem 0;
            border-bottom: 1px solid #eee;
            text-decoration: none;
            color: #555;
            transition: color 0.2s;
        }

            .quick-link-item:last-child {
                border-bottom: none;
            }

            .quick-link-item:hover {
                color: var(--primary-color);
            }

        .quick-link-icon {
            background-color: #eef5ff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
            color: var(--primary-color);
        }

        .date-display {
            font-size: 0.9rem;
            color: #6c757d;
            background-color: #f8f9fa;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            display: inline-block;
        }

      
    </style>
</head>
<body>
    <div class="container">
        <!-- Dashboard Header -->
        <div class="dashboard-header">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2><i class="bi bi-speedometer2 me-2"></i>Student Dashboard</h2>
                        <p>Welcome to your Madrasah Management Portal</p>
                    </div>
                    <div class="date-display">
                        <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dddd, MMMM dd, yyyy")
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row mb-4">
            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card stats-card">
                    <div class="card-body">
                        <div class="card-icon attendance-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <h5 class="card-title">Today's Attendance</h5>
                        @if (Model.TodayAttendance == "Present")
                        {
                            <div class="card-value attendance-present">@Model.TodayAttendance</div>
                            <small class="text-muted">Marked at 8:30 AM</small>
                        }
                        else if (Model.TodayAttendance == "Absent")
                        {
                            <div class="card-value attendance-absent">@Model.TodayAttendance</div>
                            <small class="text-muted">Reported absence</small>
                        }
                        else if (Model.TodayAttendance == "Late")
                        {
                            <div class="card-value attendance-late">@Model.TodayAttendance</div>
                            <small class="text-muted">Arrived at 9:15 AM</small>
                        }
                        else
                        {
                            <div class="card-value">@Model.TodayAttendance</div>
                            <small class="text-muted">Not marked yet</small>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card stats-card">
                    <div class="card-body">
                        <div class="card-icon assignments-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <h5 class="card-title">Pending Assignments</h5>
                        <div class="card-value">@Model.PendingAssignments</div>
                        <small class="text-muted">
                            @if (Model.PendingAssignments > 0)
                            {
                                <span class="text-danger">Due soon: @(Model.PendingAssignments > 2 ? 2 : Model.PendingAssignments)</span>
                            }
                            else
                            {
                                <span class="text-success">All caught up!</span>
                            }
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card stats-card">
                    <div class="card-body">
                        <div class="card-icon" style="color: var(--success-color);">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <h5 class="card-title">Completed Assignments</h5>
                        <div class="card-value" style="color: var(--success-color);">12</div>
                        <small class="text-muted">Last submitted: Yesterday</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 mb-4">
                <div class="card stats-card">
                    <div class="card-body">
                        <div class="card-icon" style="color: var(--secondary-color);">
                            <i bi bi-megaphone"></i>
                        </div>
                        <h5 class="card-title">Active Notices</h5>
                        <div class="card-value" style="color: var(--secondary-color);">@Model.RecentNotices.Count</div>
                        <small class="text-muted">@Model.RecentNotices.Count(rn => rn.DatePosted.Date == DateTime.Today) new today</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Recent Notices Section -->
            <div class="col-lg-8">
                <div class="notices-section">
                    <h4 class="section-title"><i class="bi bi-megaphone me-2"></i>Recent Notices</h4>

                    @if (Model.RecentNotices.Any())
                    {
                        <div class="row">
                            @foreach (var notice in Model.RecentNotices)
                            {
                                <div class="col-md-6 mb-3">
                                    <div class="card notice-card">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <h6 class="notice-title">@notice.Title</h6>
                                                @if (notice.DatePosted.Date == DateTime.Today)
                                                {
                                                    <span class="badge badge-new">NEW</span>
                                                }
                                            </div>
                                            <div class="notice-date">
                                                <i class="bi bi-calendar me-1"></i> @notice.DatePosted.ToString("dd/MM/yyyy")
                                                @if (notice.DatePosted.Date == DateTime.Today)
                                                {
                                                    <span class="ms-2"><i class="bi bi-clock me-1"></i>@notice.DatePosted.ToString("hh:mm tt")</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(notice.Content))
                                            {
                                                <p class="notice-content">@(notice.Content.Length > 120 ? notice.Content.Substring(0, 120) + "..." : notice.Content)</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-megaphone"></i>
                            <h5>No notices available</h5>
                            <p>Check back later for updates from your teachers</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Links & Additional Info -->
            <div class="col-lg-4">
                <div class="quick-links">
                    <h5><i class="bi bi-link-45deg me-2"></i>Quick Links</h5>

                    <a href="#" class="quick-link-item">
                        <div class="quick-link-icon">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div>
                            <div>My Assignments</div>
                            <small class="text-muted">View and submit assignments</small>
                        </div>
                    </a>

                    <a href="#" class="quick-link-item">
                        <div class="quick-link-icon">
                            <i class="bi bi-calendar-week"></i>
                        </div>
                        <div>
                            <div>Class Schedule</div>
                            <small class="text-muted">View today's timetable</small>
                        </div>
                    </a>

                    <a href="#" class="quick-link-item">
                        <div class="quick-link-icon">
                            <i class="bi bi-clipboard-data"></i>
                        </div>
                        <div>
                            <div>Progress Report</div>
                            <small class="text-muted">Check your academic progress</small>
                        </div>
                    </a>

                    <a href="#" class="quick-link-item">
                        <div class="quick-link-icon">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <div>
                            <div>My Profile</div>
                            <small class="text-muted">Update personal information</small>
                        </div>
                    </a>

                    <a href="#" class="quick-link-item">
                        <div class="quick-link-icon">
                            <i class="bi bi-book"></i>
                        </div>
                        <div>
                            <div>Study Materials</div>
                            <small class="text-muted">Access learning resources</small>
                        </div>
                    </a>
                </div>

                <!-- Upcoming Events Placeholder -->
                <div class="quick-links mt-4">
                    <h5><i class="bi bi-calendar-event me-2"></i>Upcoming Events</h5>
                    <div class="text-center py-3">
                        <i class="bi bi-calendar2-week" style="font-size: 2.5rem; color: #ccc;"></i>
                        <p class="text-muted mt-2 mb-0">No upcoming events</p>
                        <small>Events will appear here when scheduled</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Simple animation for card values
        document.addEventListener('DOMContentLoaded', function() {
            // Animate counting up for assignments if needed
            const pendingAssignments = @Model.PendingAssignments;
            if (pendingAssignments > 0) {
                const assignmentElement = document.querySelectorAll('.card-value')[1];
                let count = 0;
                const interval = setInterval(() => {
                    count++;
                    assignmentElement.textContent = count;
                    if (count >= pendingAssignments) {
                        clearInterval(interval);
                    }
                }, 50);
            }
        });
    </script>
</body>
</html>