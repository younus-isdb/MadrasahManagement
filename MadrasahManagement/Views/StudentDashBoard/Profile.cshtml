@model Student

<h2>Student Profile</h2>

<p><strong>Name:</strong> @Model.StudentName</p>
<p><strong>Registration:</strong> @Model.RegNo</p>
<p><strong>Class:</strong> @Model.Class?.ClassName</p>
<p><strong>Section:</strong> @Model.Section?.SectionName</p>
<p><strong>Father:</strong> @Model.FatherName</p>
<p><strong>Phone:</strong> @Model.FatherPhone</p>
<p><strong>Address:</strong> @Model.Address</p>

<a asp-action="ChangePassword" class="btn btn-primary">Change Password</a>