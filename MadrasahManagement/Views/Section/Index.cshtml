@model IEnumerable<MadrasahManagement.Models.Section>

@{
    ViewData["Title"] = "Section List";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Sections</h6>
            <a class="btn btn-primary" href="/Section/Create">
                <i class="fas fa-plus"></i> Create New
            </a>
        </div>
        <div class="card-body">

            <!-- Filter Form -->
            <form method="get" class="mb-4" id="filterForm">
                <div class="row">
                    <div class="col-md-3">
                        <label>Department</label>
                        <select name="departmentId" id="departmentId" class="form-control" onchange="this.form.submit()">
                            <option value="">All Departments</option>
                            @foreach (var item in ViewBag.Departments as List<SelectListItem>)
                            {
                                <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedDepartmentId?.ToString())">
                                    @item.Text
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>Class</label>
                        <select name="classId" id="classId" class="form-control">
                            <option value="">All Classes</option>
                            @if (ViewBag.Classes != null)
                            {
                                foreach (var item in ViewBag.Classes as List<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedClassId?.ToString())">
                                        @item.Text
                                    </option>
                                }
                            }
                            else
                            {
                                // Show all classes if no department is selected
                                @foreach (var item in ViewBag.AllClasses as List<SelectListItem>)
                                {
                                    <option value="@item.Value" selected="@(item.Value == ViewBag.SelectedClassId?.ToString())">
                                        @item.Text
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label>&nbsp;</label><br />
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-filter"></i> Filter Sections
                        </button>
                        <a href="/Section" class="btn btn-secondary">Clear</a>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Section Name</th>
                                <th>Class</th>
                                <th>Department</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.SectionName</td>
                                    <td>@item.Class?.ClassName</td>
                                    <td>@item.Class?.Department?.DepartmentName</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="/Section/Details/@item.SectionId" class="btn btn-info btn-sm">Details</a>
                                            <a href="/Section/Edit/@item.SectionId" class="btn btn-warning btn-sm">Edit</a>
                                            <a href="/Section/Delete/@item.SectionId" class="btn btn-danger btn-sm">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info">
                        @if (ViewBag.SelectedDepartmentId != null || ViewBag.SelectedClassId != null)
                        {
                            <p>No sections found for the selected filters.</p>
                        }
                        else
                        {
                            <p>No sections available. Use the filter options to view sections.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Only initialize DataTable if there's data
            if ($('#dataTable').length) {
                $('#dataTable').DataTable({
                    "order": [[2, "asc"], [1, "asc"], [0, "asc"]] // Sort by Department, Class, then Section Name
                });
            }
        });
    </script>
}