@model Section

<form id="sectionCreateForm" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()

    <!-- Department Dropdown -->
    <div class="mb-3">
        <label asp-for="DepartmentId" class="form-label">Department</label>
        <select asp-for="DepartmentId" class="form-control" id="modalDeptId" required>
            <option value="">Select Department</option>
            @foreach (var dept in ViewBag.DepartmentList)
            {
                <option value="@dept.DepartmentId">@dept.DepartmentName</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <!-- Class Dropdown (will be populated based on department) -->
    <div class="mb-3">
        <label asp-for="ClassId" class="form-label">Class</label>
        <select asp-for="ClassId" class="form-control" id="modalClassId" required disabled>
            <option value="">Select Class</option>
        </select>
        <span asp-validation-for="ClassId" class="text-danger"></span>
    </div>

    <!-- Section Name -->
    <div class="mb-3">
        <label asp-for="SectionName" class="form-label">Section Name</label>
        <input asp-for="SectionName" class="form-control" placeholder="Enter Section Name" required />
        <span asp-validation-for="SectionName" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create
        </button>

        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle"></i> Close
        </button>
    </div>
</form>

<script>
    $(function() {
        // When department changes in modal, load its classes
        $("#modalDeptId").change(function() {
            var deptId = $(this).val();
            var classDropdown = $("#modalClassId");

            if (deptId) {
                // Enable class dropdown
                classDropdown.prop('disabled', false);

                // Load classes for this department
                $.get('/Student/GetClasses', { departmentId: deptId }, function(data) {
                    classDropdown.empty().append('<option value="">Select Class</option>');
                    $.each(data, function(i, c) {
                        classDropdown.append('<option value="' + c.classId + '">' + c.className + '</option>');
                    });
                });
            } else {
                // Disable and clear class dropdown
                classDropdown.prop('disabled', true);
                classDropdown.empty().append('<option value="">Select Class</option>');
            }
        });

        // Form submission
        $("#sectionCreateForm").submit(function (e) {
            e.preventDefault();

            var form = $(this);
            var submitBtn = form.find('.btn-primary');
            var originalText = submitBtn.html();

            // Show loading
            submitBtn.html('<span class="spinner-border spinner-border-sm"></span> Creating...').prop('disabled', true);

            $.ajax({
                url: "/Section/CreateModalPost",
                type: "POST",
                data: form.serialize(),
                success: function (res) {
                    submitBtn.html(originalText).prop('disabled', false);

                    if (res.success) {
                        $('#sectionModal').modal('hide');

                        // Get selected class from modal
                        var classId = $("#modalClassId").val();
                        if (classId && window.parent && window.parent.RefreshSectionList) {
                            window.parent.RefreshSectionList(classId);
                        }
                    } else {
                        alert("Failed to create section. Please check the form.");
                    }
                },
                error: function() {
                    submitBtn.html(originalText).prop('disabled', false);
                    alert("Error creating section");
                }
            });
        });
    });
</script>