@model MadrasahManagement.Models.Section

@{
    ViewData["Title"] = "Create Section";
}

<h2 class="mb-4">Create New Section</h2>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="get">
                    <!-- Step 1: Select Department -->
                    <div class="mb-3">
                        <label class="form-label">Select Department</label>
                        <select name="departmentId" class="form-control" onchange="this.form.submit()">
                            <option value="">-- Select Department --</option>
                            @foreach (var dept in ViewBag.Departments as List<SelectListItem>)
                            {
                                <option value="@dept.Value" selected="@(dept.Value == ViewBag.SelectedDepartmentId?.ToString())">
                                    @dept.Text
                                </option>
                            }
                        </select>
                    </div>
                </form>
               
                @if (ViewBag.SelectedDepartmentId != null)
                {
                    <hr />
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="DepartmentId" value="@ViewBag.SelectedDepartmentId" />

                        <!-- Step 2: Select Class -->
                        <div class="mb-3">
                            <label asp-for="ClassId" class="form-label"></label>
                            <select asp-for="ClassId" class="form-control" required>
                                <option value="">-- Select Class --</option>
                                @foreach (var cls in ViewBag.Classes as List<SelectListItem>)
                                {
                                    <option value="@cls.Value">@cls.Text</option>
                                }
                            </select>
                            <span asp-validation-for="ClassId" class="text-danger"></span>
                        </div>

                        <!-- Step 3: Enter Section Name -->
                        <div class="mb-3">
                            <label asp-for="SectionName" class="form-label"></label>
                            <input asp-for="SectionName" class="form-control" placeholder="Enter Section Name" required />
                            <span asp-validation-for="SectionName" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Create Section
                            </button>
                            <a asp-action="Create" class="btn btn-warning">
                                <i class="bi bi-arrow-clockwise"></i> Change Department
                            </a>
                        </div>
                    </form>
                }
            </div>
           
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>